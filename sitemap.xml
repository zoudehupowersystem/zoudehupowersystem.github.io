---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
    <lastmod>2026-09-09</lastmod>
  </url>
  <url>
    <loc>{{ site.url }}/en.html</loc>
    <lastmod>2026-09-09</lastmod>
  </url>
  <url>
    <loc>{{ site.url }}/blog.html</loc>
    <lastmod>2026-09-09</lastmod>
  </url>
  <url>
    <loc>{{ site.url }}/english.html</loc>
    <lastmod>2026-09-09</lastmod>
  </url>
{% assign standard_articles = site.pages | where: 'layout', 'article' | sort: 'url' %}
{% for p in standard_articles %}
  <url>
    <loc>{{ site.url }}{{ p.url | uri_escape }}</loc>{% if p.updated %}
    <lastmod>{{ p.updated | date: '%Y-%m-%d' }}</lastmod>{% endif %}
  </url>
{% endfor %}
{% assign manitoba_articles = site.pages | where: 'layout', 'manitoba' | sort: 'url' %}
{% for p in manitoba_articles %}
  <url>
    <loc>{{ site.url }}{{ p.url | uri_escape }}</loc>{% if p.updated %}
    <lastmod>{{ p.updated | date: '%Y-%m-%d' }}</lastmod>{% endif %}
  </url>
{% endfor %}
</urlset>
